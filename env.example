# Copy this file to .env and fill in your values.

# Required — your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-token-here

# Optional — prefix for legacy text commands (not used for slash commands)
COMMAND_PREFIX=!

# Optional — UTC hour (0-23) at which the daily summary is posted (default: 0 = midnight UTC)
DAILY_SUMMARY_UTC_HOUR=0
